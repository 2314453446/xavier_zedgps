export ADE_NAME=camera_py

export ADE_DOCKER_RUN_ARGS="--runtime nvidia \
 --cap-add=SYS_PTRACE \
 --privileged \
 --net=host \
 --hostname camera_py \
 --add-host camera:127.0.0.1 \
 -v /dev:/dev \
 -e ROS_DOMAIN_ID=0 \
 -e NVIDIA_VISIBLE_DEVICES=all \
 -e NVIDIA_DRIVER_CAPABILITIES=all \
 -v ${HOME}/.Xauthority:${HOME}/.Xauthority:ro \
 -e XAUTHORITY=${HOME}/.Xauthority \
 -v /tmp/.X11-unix:/tmp/.X11-unix \
 -e DISPLAY \

 -v /home/tuolong/Documents/project/ws_xavier/third_party/zed/resources:/usr/local/zed/resources
"

export ADE_IMAGES="openzed-env:aarch64_ros2_foxy_zed_latest"
